# Optional server-only configuration. No key is needed for shipped examples/templates.
# Use Model settings for session-only keys, or copy this template to a NEW root
# .env. Do not overwrite existing configuration or commit real keys.
# Restart the local server after changes. API access/billing is separate from
# Claude/ChatGPT subscriptions; the default model may not be available to you.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default provider for new sessions: anthropic or openai.
# Use LLM_PROVIDER=anthropic to default to Anthropic. Model settings can switch the
# provider for the current session; this does not change the default below.
LLM_PROVIDER=openai

# Built-in defaults; uncomment to override. Custom Model settings override these.
# ANTHROPIC_MODEL=claude-fable-5-1
# OPENAI_MODEL=gpt-6-astra

# Optional per-task overrides: SPEC, CREATIVE, CONVERT, ANIMATE, EDIT.
# ANTHROPIC_MODEL_SPEC=claude-fable-5-1
# ANTHROPIC_MODEL_CREATIVE=claude-fable-5-1
# ANTHROPIC_MODEL_CONVERT=claude-fable-5-1
# ANTHROPIC_MODEL_ANIMATE=claude-fable-5-1
# ANTHROPIC_MODEL_EDIT=claude-fable-5-1
# OPENAI_MODEL_SPEC=gpt-6-astra
# OPENAI_MODEL_CREATIVE=gpt-6-astra
# OPENAI_MODEL_CONVERT=gpt-6-astra
# OPENAI_MODEL_ANIMATE=gpt-6-astra
# OPENAI_MODEL_EDIT=gpt-6-astra

# Legacy VITE_ANTHROPIC_API_KEY, VITE_ANTHROPIC_MODEL, and
# VITE_ANTHROPIC_MODEL_TASK are still accepted server-side (new names win).
# Vite envPrefix: [] disables automatic VITE_ variable bundling.

# Companion access: comma-separated exact local http origins, no trailing slash.
# Use the same hostname for both apps so SameSite=Strict session cookies work.
# LLM_ALLOWED_ORIGINS=http://127.0.0.1:5274
LLM_ALLOWED_ORIGINS=

# Session keys expire after one hour idle or are forgotten on server restart.
# Forget key removes only the session key. To stop using an environment key,
# remove it here/from the process environment manually and restart the server.
